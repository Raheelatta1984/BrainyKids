# Optional locally; recommended on Vercel / serverless hosts.
# Without it, BrainyKids stores accounts, kid profiles and device links in a
# JSON file under .data/ (fine for local development and single-family installs).
#
# On Vercel, attach a Neon (Serverless Postgres) database in the Storage tab —
# BrainyKids automatically picks up DATABASE_URL, POSTGRES_URL or NEON_DATABASE_URL.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Strongly recommended for public deployments: set a long random secret.
# It protects signed cookies and pseudonymised signup-rate-limit client keys.
# BRAINYKIDS_SECRET=replace-with-a-long-random-value

# Optional. Change where the JSON file lives when no database is configured.
# BRAINYKIDS_DATA_DIR=/var/lib/brainykids

# Optional. Fingerprint / face unlock (passkeys) normally uses the web address a
# browser requested, which is what you want. Override these only behind a
# rewriting proxy that hides the public host or origin.
# BRAINYKIDS_RP_ID=brainykids.example.com
# BRAINYKIDS_ORIGINS=https://brainykids.example.com
