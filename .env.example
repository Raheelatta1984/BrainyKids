# Optional. Without it, BrainyKids stores accounts, kid profiles and device
# links in a JSON file under .data/ (fine for local development and single-family
# installs). Set it on hosts that run more than one instance.
DATABASE_URL=postgresql://user:password@host:5432/brainykids

# Optional. Change where the JSON file lives when no database is configured.
# BRAINYKIDS_DATA_DIR=/var/lib/brainykids
