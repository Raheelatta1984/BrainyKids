# Optional. Without it, BrainyKids stores accounts, kid profiles and device
# links in a JSON file under .data/ (fine for local development and single-family
# installs). Set it on hosts that run more than one instance.
#
# If the project folder is read-only (hosts with an ephemeral filesystem) and no
# database is configured, BrainyKids falls back to a temporary folder and warns
# on the dashboard that accounts will not survive a restart.
DATABASE_URL=postgresql://user:password@host:5432/brainykids

# Optional. Change where the JSON file lives when no database is configured.
# BRAINYKIDS_DATA_DIR=/var/lib/brainykids

# Optional. Fingerprint / face unlock (passkeys) normally uses the web address a
# browser requested, which is what you want. Override these only behind a
# rewriting proxy that hides the public host or origin.
# BRAINYKIDS_RP_ID=brainykids.example.com
# BRAINYKIDS_ORIGINS=https://brainykids.example.com
